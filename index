    /* ---- MOBILE NAV ---- */
    (function () {
      var btn  = document.querySelector('.nav-toggle');
      var menu = document.getElementById('nav-menu');

      btn.addEventListener('click', function () {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', String(!expanded));
        this.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
        menu.classList.toggle('is-open', !expanded);
      });

      document.addEventListener('click', function (e) {
        if (!btn.contains(e.target) && !menu.contains(e.target)) {
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open navigation menu');
          menu.classList.remove('is-open');
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.classList.contains('is-open')) {
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open navigation menu');
          menu.classList.remove('is-open');
          btn.focus();
        }
      });
    }());

    /* ---- ROLE CARD CAROUSEL ----
       Motion safety:
         Transition:  600 ms smooth fade — NOT a flash/blink (monotonic opacity)
         Interval:   3000 ms hold + 600 ms fade = 3600 ms per cycle = 0.28 Hz
         Both rates are safely below the 2 Hz lower bound of the prohibited
         flash range (2–55 Hz per WCAG 2.3 / Section 508 1194.21(b)).
         prefers-reduced-motion: animation disabled; final card shown statically.
    ---- */
    (function () {
      var roles = [
        'a UX Designer',
        'a UX Researcher',
        'a Data Analyst',
        'an Accessibility Architect'
      ];

      var cards      = roles.map(function (_, i) { return document.getElementById('role-' + i); });
      var wrapper    = document.querySelector('.role-card-wrapper');
      var liveRegion = document.getElementById('role-live');
      var current    = 0;
      var timer      = null;

      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* For reduced-motion users: replace carousel with static final card */
      if (prefersReduced.matches) {
        var staticCard = document.createElement('span');
        staticCard.className = 'role-card is-accent';
        staticCard.textContent = roles[roles.length - 1];
        staticCard.setAttribute('aria-hidden', 'false');
        wrapper.innerHTML = '';
        wrapper.appendChild(staticCard);
        liveRegion.textContent = "Hi, I'm Huda, " + roles[roles.length - 1] +
          ' who designs sustainable solutions for human-centered problems.';
        return;
      }

      /* Initial screen-reader announcement */
      liveRegion.textContent = "Hi, I'm Huda, " + roles[0] +
        ' who designs sustainable solutions for human-centered problems.';

      function advance () {
        var prev = current;
        current  = (current + 1) % cards.length;

        /* Outgoing card: remove from flow, hide */
        cards[prev].setAttribute('aria-hidden', 'true');

        /* Incoming card: put back in flow first so wrapper sizes to it, then fade in */
        cards[current].setAttribute('aria-hidden', 'false');

        liveRegion.textContent = '';
        requestAnimationFrame(function () {
          liveRegion.textContent = "Hi, I'm Huda, " + roles[current] +
            ' who designs sustainable solutions for human-centered problems.';
        });

        scheduleNext();
      }

      function scheduleNext () {
        timer = setTimeout(advance, 3000);
      }

      scheduleNext();

      prefersReduced.addEventListener('change', function (e) {
        if (e.matches) { clearTimeout(timer); }
        else           { scheduleNext(); }
      });
    }());

    /* ---- SCROLL REVEAL ---- */
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var els = document.querySelectorAll('.reveal');
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });

      els.forEach(function (el) { obs.observe(el); });
    }());

    /* ---- CONTACT FORM VALIDATION ---- */
    (function () {
      var form    = document.getElementById('contact-form');
      var success = document.getElementById('form-success');

      function validate (groupId, condition) {
        var group = document.getElementById(groupId);
        group.classList.toggle('has-error', !condition);
        return condition;
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var name    = document.getElementById('contact-name').value.trim();
        var email   = document.getElementById('contact-email').value.trim();
        var message = document.getElementById('contact-message').value.trim();
        var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        var ok = true;
        ok = validate('fg-name',    name.length > 0)    && ok;
        ok = validate('fg-email',   emailRe.test(email)) && ok;
        ok = validate('fg-message', message.length > 0) && ok;

        if (!ok) {
          var first = form.querySelector('.has-error input, .has-error textarea');
          if (first) first.focus();
          return;
        }

        form.style.display   = 'none';
        success.style.display = 'block';
        success.focus();
      });

      form.addEventListener('input', function (e) {
        var group = e.target.closest('.form-group');
        if (group) group.classList.remove('has-error');
      });
    }());
  </script>

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Huda Hassoun – UX Designer, UX Researcher, Data Analyst, and Accessibility Architect who designs sustainable solutions for human-centered problems." />
  <title>Huda Hassoun — UX Designer & Accessibility Architect</title>

  <style>
    /* =============================================
       SKIP LINK
    ============================================= */
    .skip-link {
      position: absolute;
      top: -100%;
      left: 1rem;
      z-index: 9999;
      padding: 0.75rem 1.5rem;
      background: #04724D;
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      border-radius: 0 0 8px 8px;
      text-decoration: none;
      transition: top 0.15s;
    }
    .skip-link:focus {
      top: 0;
      outline: 3px solid #F3DC67;
      outline-offset: 2px;
    }

    /* =============================================
       CSS CUSTOM PROPERTIES
       Color contrast notes (WCAG 2.0 AA):
       --clr-green-dark  #04724D on white  → 6.1:1  ✅ (normal text)
       --clr-purple-text #7A3E99 on white  → 6.2:1  ✅ (normal text)
       --clr-green-text  #3E7A3B on white  → 5.4:1  ✅ (normal text)
       --clr-yellow      #F3DC67 on #04724D→ 8.1:1  ✅ (on dark bg only)
       --clr-yellow      NEVER used as text on white (1.5:1 ❌)
    ============================================= */
    :root {
      /* Brand palette */
      --clr-green-dark:   #04724D;   /* 6.1:1 on white ✅ */
      --clr-purple-raw:   #AD74C4;   /* decorative only — NOT text on white */
      --clr-purple-text:  #7A3E99;   /* 6.2:1 on white ✅ */
      --clr-green-mid:    #61A45E;   /* decorative only — NOT text on white */
      --clr-green-text:   #3E7A3B;   /* 5.4:1 on white ✅ */
      --clr-yellow:       #F3DC67;   /* 8.1:1 on #04724D ✅; decorative on light bg */

      /* UI colours */
      --clr-ink:          #1A2A22;   /* near-black with green tint, 16.8:1 on white ✅ */
      --clr-body:         #3B4A40;   /* dark body text, 9.1:1 on white ✅ */
      --clr-muted:        #5A6B5E;   /* muted text, 5.1:1 on white ✅ */
      --clr-white:        #FFFFFF;
      --clr-off-white:    #F4F7F5;
      --clr-green-tint:   #E8F4EE;   /* very light green for bg tints */
      --clr-purple-tint:  #F3EAF8;
      --clr-border:       #C8D5CC;

      /* Typography */
      --ff-display: 'DM Serif Display', serif;
      --ff-body:    'DM Sans', sans-serif;
      --ff-mono:    'DM Mono', monospace;

      /* Shape */
      --radius-sm:  6px;
      --radius-md:  12px;
      --radius-lg:  20px;
      --radius-xl:  32px;

      /* Shadow */
      --shadow-card:  0 2px 16px rgba(4,114,77,0.10);
      --shadow-hover: 0 8px 32px rgba(4,114,77,0.18);

      /* Layout */
      --nav-h:  72px;
      --max-w: 1140px;

      /* Motion — safe rates */
      --card-duration: 600ms;   /* fade = NOT a flash */
      --card-interval: 3000ms;  /* ~0.28 Hz total cycle — well below 2 Hz */
    }

    /* =============================================
       RESET & BASE
    ============================================= */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; font-size: 100%; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important;
      }
    }

    body {
      font-family: var(--ff-body);
      color: var(--clr-ink);
      background: var(--clr-white);
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
    }

    img, svg { display: block; max-width: 100%; }

    a {
      color: var(--clr-green-dark);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    a:hover { color: var(--clr-purple-text); }
    a:focus-visible {
      outline: 3px solid var(--clr-green-dark);
      outline-offset: 3px;
      border-radius: 2px;
    }

    h1, h2, h3 {
      font-family: var(--ff-display);
      line-height: 1.2;
      color: var(--clr-ink);
    }

    /* =============================================
       VISUALLY HIDDEN (accessible)
    ============================================= */
    .sr-only {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }

    /* =============================================
       LAYOUT UTILITIES
    ============================================= */
    .container {
      width: 100%;
      max-width: var(--max-w);
      margin-inline: auto;
      padding-inline: clamp(1rem, 4vw, 2rem);
    }

    section { padding-block: clamp(4rem, 8vw, 7rem); }

    .section-label {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--ff-mono);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--clr-green-dark);
      margin-bottom: 1rem;
    }
    .section-label::before {
      content: '';
      display: inline-block;
      width: 24px; height: 2px;
      background: var(--clr-green-dark);
      border-radius: 2px;
    }

    .section-heading {
      font-size: clamp(1.75rem, 4vw, 2.75rem);
      margin-bottom: 1rem;
    }

    .section-sub {
      font-size: 1.0625rem;
      color: var(--clr-muted);
      max-width: 52ch;
      line-height: 1.7;
    }

    /* =============================================
       NAVIGATION
    ============================================= */
    .site-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      height: var(--nav-h);
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--clr-border);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    .nav-logo {
      font-family: var(--ff-display);
      font-size: 1.35rem;
      color: var(--clr-ink);
      text-decoration: none;
      letter-spacing: -0.01em;
    }
    .nav-logo:hover { color: var(--clr-green-dark); }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 0.25rem;
      align-items: center;
    }

    .nav-links a {
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--clr-ink);
      text-decoration: none;
      padding: 0.5rem 0.875rem;
      border-radius: var(--radius-sm);
      transition: background 0.15s, color 0.15s;
    }
    .nav-links a:hover {
      background: var(--clr-green-tint);
      color: var(--clr-green-dark);
    }
    .nav-links a:focus-visible {
      outline: 3px solid var(--clr-green-dark);
      outline-offset: 2px;
      background: var(--clr-green-tint);
    }

    .nav-cta {
      background: var(--clr-green-dark) !important;
      color: var(--clr-white) !important;
      padding: 0.5rem 1.125rem !important;
      border-radius: var(--radius-sm) !important;
    }
    .nav-cta:hover {
      background: var(--clr-purple-text) !important;
      color: var(--clr-white) !important;
    }

    .nav-toggle {
      display: none;
      background: none;
      border: 2px solid var(--clr-ink);
      border-radius: var(--radius-sm);
      padding: 0.4rem 0.6rem;
      cursor: pointer;
      color: var(--clr-ink);
      font-size: 1rem;
      line-height: 1;
    }
    .nav-toggle:focus-visible {
      outline: 3px solid var(--clr-green-dark);
      outline-offset: 2px;
    }

    @media (max-width: 768px) {
      .nav-toggle { display: flex; align-items: center; }
      .nav-links {
        display: none;
        position: absolute;
        top: var(--nav-h);
        left: 0; right: 0;
        background: var(--clr-white);
        flex-direction: column;
        align-items: stretch;
        padding: 1rem;
        border-bottom: 1px solid var(--clr-border);
        box-shadow: var(--shadow-card);
        gap: 0.25rem;
      }
      .nav-links.is-open { display: flex; }
      .nav-links a { padding: 0.75rem 1rem; }
    }

    /* =============================================
       HERO SECTION
    ============================================= */
    #hero {
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: var(--nav-h);
      background: var(--clr-white);
      position: relative;
      overflow: hidden;
    }

    /* Decorative background circle */
    #hero::before {
      content: '';
      position: absolute;
      top: -10%; right: -5%;
      width: clamp(260px, 42vw, 560px);
      height: clamp(260px, 42vw, 560px);
      background: var(--clr-green-tint);
      border-radius: 50%;
      z-index: 0;
      pointer-events: none;
    }
    /* Second decorative blob */
    #hero::after {
      content: '';
      position: absolute;
      bottom: 5%; left: -4%;
      width: clamp(140px, 20vw, 280px);
      height: clamp(140px, 20vw, 280px);
      background: var(--clr-purple-tint);
      border-radius: 50%;
      z-index: 0;
      pointer-events: none;
    }

    .hero-inner {
      position: relative;
      z-index: 1;
      width: 100%;
    }

    .hero-content { width: 100%; }

    .hero-eyebrow {
      font-family: var(--ff-mono);
      font-size: 0.875rem;
      letter-spacing: 0.1em;
      color: var(--clr-green-dark);
      font-weight: 500;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
    }

    /* ---- HERO HEADING ---- */
    /*
      Layout:
        Line 1: "Hi, I'm Huda,"           ← plain text
        Line 2: [changing card]            ← animated card, block-level
        Line 3: "who designs..."           ← plain text
    */
    .hero-headline {
      font-family: var(--ff-display);
      font-size: clamp(2.25rem, 5.5vw, 4rem);
      line-height: 1.15;
      color: var(--clr-ink);
      margin-bottom: 1.75rem;
      text-align: center;
    }

    .hero-line-static {
      display: block;
    }

    /* ---- ROLE CARD CAROUSEL ---- */
    /*
      The card occupies its own block line. Height is fixed to match
      the display font line height so it never overlaps adjacent lines.
      Cards are stacked (position: absolute within the relative wrapper).
    */
    /*
      Wrapper: inline-flex so it hugs the card's natural size.
      The card sits in normal flow — no fixed height, no guesswork.
      overflow: hidden clips the tiny translateY nudge during the fade
      so it never bleeds into adjacent lines.
    */
    .role-card-wrapper {
      display: block;
      text-align: center;
      /* No overflow: hidden — lets the card grow to its natural height */
      margin-block: 0.05em;
    }

    .role-card {
      display: inline;
      padding: 0.1em 0.55em 0.15em;
      background: var(--clr-green-dark);   /* white text on #04724D = 6.1:1 ✅ */
      color: var(--clr-white);
      border-radius: var(--radius-sm);
      font-family: var(--ff-display);
      font-size: inherit;
      line-height: 1.4;
      /* Allow text to wrap naturally — no forced single line */
      white-space: normal;
      /* box-decoration-break ensures padding/radius apply on every wrapped line */
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
      /*
        Transition: opacity + vertical nudge.
        600 ms fade — not a flash/blink.
        Interval 3000 ms → 0.28 Hz cycle rate, well below 2 Hz lower bound.
      */
      transition: opacity var(--card-duration) ease,
                  transform var(--card-duration) ease;
      will-change: opacity, transform;
    }

    /* Accessibility Architect card — purple accent */
    .role-card.is-accent {
      background: var(--clr-purple-text);  /* white text on #7A3E99 = 6.2:1 ✅ */
    }

    /* Hidden state */
    .role-card[aria-hidden="true"] {
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
    }

    /* Visible state — in normal flow so wrapper sizes to it */
    .role-card[aria-hidden="false"] {
      opacity: 1;
      transform: translateY(0);
      position: static;
      width: auto; height: auto;
      overflow: visible;
      clip: auto;
    }
    }

    .hero-tagline {
      display: block;
    }

    .hero-tagline em {
      font-style: italic;
      color: var(--clr-muted);
    }

    /* Live region — visually hidden, read aloud by screen readers */
    #role-live {
      position: absolute;
      width: 1px; height: 1px;
      padding: 0; margin: -1px;
      overflow: hidden;
      clip: rect(0,0,0,0);
      white-space: nowrap;
      border: 0;
    }

    .hero-desc {
      font-size: 1.125rem;
      color: var(--clr-muted);
      max-width: 50ch;
      line-height: 1.7;
      margin-top: 1.5rem;
      margin-bottom: 2.5rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--ff-body);
      font-weight: 600;
      font-size: 0.9375rem;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      cursor: pointer;
      transition: background 0.18s, color 0.18s, box-shadow 0.18s, transform 0.12s;
      border: 2px solid transparent;
    }
    .btn:focus-visible {
      outline: 3px solid var(--clr-green-dark);
      outline-offset: 3px;
    }
    .btn:active { transform: scale(0.97); }

    .btn-primary {
      background: var(--clr-green-dark);  /* white on #04724D = 6.1:1 ✅ */
      color: var(--clr-white);
    }
    .btn-primary:hover { background: var(--clr-purple-text); color: var(--clr-white); }

    .btn-outline {
      background: transparent;
      color: var(--clr-ink);
      border-color: var(--clr-ink);
    }
    .btn-outline:hover {
      background: var(--clr-ink);
      color: var(--clr-white);
    }

    @media (max-width: 768px) {
      .hero-actions { justify-content: center; }
      .hero-desc { margin-inline: auto; }
      .section-sub { margin-inline: auto; }
      .role-card-wrapper { text-align: left; }
    }

    /* =============================================
       CASE STUDIES
    ============================================= */
    #case-studies { background: var(--clr-off-white); }

    .cs-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .cs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
      gap: 1.75rem;
    }

    .cs-card {
      background: var(--clr-white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-card);
      transition: box-shadow 0.2s, transform 0.2s;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
    }
    .cs-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-4px); }
    .cs-card:focus-visible { outline: 3px solid var(--clr-green-dark); outline-offset: 3px; }

    .cs-thumb {
      height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .cs-thumb-1 { background: var(--clr-green-tint); }
    .cs-thumb-2 { background: var(--clr-purple-tint); }
    .cs-thumb-3 { background: #FFFBE8; } /* yellow tint */

    .cs-thumb-icon { font-size: 3.5rem; line-height: 1; }

    .cs-tag {
      position: absolute;
      top: 1rem; left: 1rem;
      font-family: var(--ff-mono);
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: var(--clr-green-dark);  /* white on #04724D ✅ */
      color: var(--clr-white);
      padding: 0.25em 0.65em;
      border-radius: var(--radius-sm);
    }

    .cs-body {
      padding: 1.5rem;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.625rem;
    }

    .cs-title {
      font-family: var(--ff-display);
      font-size: 1.3125rem;
      color: var(--clr-ink);
      line-height: 1.3;
    }

    .cs-desc {
      font-size: 0.9375rem;
      color: var(--clr-muted);
      line-height: 1.6;
      flex: 1;
    }

    .cs-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--ff-mono);
      font-size: 0.75rem;
      color: var(--clr-green-dark);
      font-weight: 500;
      margin-top: 0.5rem;
    }
    .cs-meta svg { width: 14px; height: 14px; flex-shrink: 0; }

    /* =============================================
       ABOUT
    ============================================= */
    #about { background: var(--clr-white); }

    .about-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: center;
    }

    .about-visual { position: relative; }

    .about-img {
      width: 100%;
      aspect-ratio: 4/5;
      border-radius: var(--radius-xl);
      background: var(--clr-green-tint);
      border: 3px solid var(--clr-green-mid);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 0.75rem;
      box-shadow: 10px 10px 0 var(--clr-yellow);
    }
    .about-img svg { width: 56px; height: 56px; fill: var(--clr-green-dark); opacity: 0.4; }
    .about-img span { font-size: 0.8125rem; color: var(--clr-muted); }

    .about-stat {
      position: absolute;
      background: var(--clr-white);
      border: 1px solid var(--clr-border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      padding: 0.875rem 1.125rem;
      text-align: center;
    }
    .about-stat-num {
      font-family: var(--ff-display);
      font-size: 1.75rem;
      color: var(--clr-green-dark);
      line-height: 1;
    }
    .about-stat-lbl { font-size: 0.75rem; color: var(--clr-muted); font-weight: 500; margin-top: 0.2rem; }
    .about-stat-1 { bottom: 2rem; right: -1rem; }
    .about-stat-2 { top: 2rem; right: -1rem; }

    .about-text h2 { margin-bottom: 1rem; }
    .about-text .section-label { margin-bottom: 0.75rem; }
    .about-text p { font-size: 1.0625rem; color: var(--clr-muted); line-height: 1.75; margin-bottom: 1.25rem; }

    .skills-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
      list-style: none;
      margin-bottom: 2rem;
    }
    .skill-pill {
      font-family: var(--ff-mono);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      background: var(--clr-green-tint);
      color: var(--clr-green-dark);   /* #04724D on #E8F4EE = 5.5:1 ✅ */
      padding: 0.35em 0.85em;
      border-radius: 100px;
      border: 1px solid rgba(4,114,77,0.22);
    }

    @media (max-width: 768px) {
      .about-inner { grid-template-columns: 1fr; }
      .about-visual { display: none; }
    }

    /* =============================================
       CONTACT
    ============================================= */
    #contact { background: var(--clr-green-dark); color: var(--clr-white); }

    #contact .section-label { color: var(--clr-yellow); }   /* #F3DC67 on #04724D = 8.1:1 ✅ */
    #contact .section-label::before { background: var(--clr-yellow); }
    #contact .section-heading { color: var(--clr-white); }
    #contact .section-sub { color: #B8D4C7; }  /* light green-white, sufficient contrast */

    .contact-inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 6vw, 5rem);
      align-items: start;
    }

    .contact-info { padding-top: 0.5rem; }

    .contact-channels {
      list-style: none;
      margin-top: 2rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .contact-channels li {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .contact-icon {
      width: 44px; height: 44px;
      border-radius: var(--radius-sm);
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.18);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .contact-icon svg { width: 20px; height: 20px; fill: var(--clr-yellow); }
    .contact-channels a { color: var(--clr-white); font-size: 0.9375rem; text-decoration: none; }
    .contact-channels a:hover { color: var(--clr-yellow); }
    .contact-channels a:focus-visible { outline: 3px solid var(--clr-yellow); outline-offset: 3px; border-radius: 2px; }
    .contact-channels span { font-size: 0.75rem; color: #8FBCA8; display: block; }

    /* Form */
    .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .form-group { display: flex; flex-direction: column; gap: 0.375rem; }

    .form-group label { font-size: 0.875rem; font-weight: 500; color: #C8E0D5; }

    .form-group input,
    .form-group textarea,
    .form-group select {
      font-family: var(--ff-body);
      font-size: 0.9375rem;
      color: var(--clr-white);
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: var(--radius-sm);
      padding: 0.7rem 1rem;
      transition: border-color 0.15s, background 0.15s;
      width: 100%;
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: #6A9680; }
